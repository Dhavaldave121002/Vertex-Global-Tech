# --- EMAILJS CONFIGURATION ---

# 1. IDENTITY SERVICE (Account A)
# Capacity: 2 Templates (Used: Contact, OTP)
VITE_EMAILJS_IDENTITY_SERVICE_ID=your_primary_service_id
VITE_EMAILJS_IDENTITY_PUBLIC_KEY=your_primary_public_key
VITE_EMAILJS_IDENTITY_TEMPLATE_CONTACT=your_contact_template_id
VITE_EMAILJS_IDENTITY_TEMPLATE_OTP=your_otp_template_id

# 2. MARKETING SERVICE (Account B)
# Capacity: 2 Templates (Used: Newsletter, Referral)
VITE_EMAILJS_MARKETING_SERVICE_ID=your_secondary_service_id
VITE_EMAILJS_MARKETING_PUBLIC_KEY=your_secondary_public_key
VITE_EMAILJS_MARKETING_TEMPLATE_NEWSLETTER=your_newsletter_template_id
VITE_EMAILJS_MARKETING_TEMPLATE_REFERRAL=your_referral_template_id
